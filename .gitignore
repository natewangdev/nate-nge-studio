# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual envs
.venv/
venv/
ENV/

# Tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# App / packaging
*.log
logs/
packaging/dist/
packaging/build/
*.spec.bak

# game_scripts: only track demo/; ignore all other games and files
game_scripts/*
!game_scripts/demo/
!game_scripts/demo/**
!game_scripts/diablo4/
!game_scripts/diablo4/**
# re-ignore caches under demo (negation above would otherwise include them)
game_scripts/demo/**/__pycache__/
game_scripts/diablo4/**/__pycache__/